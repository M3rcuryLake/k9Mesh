{
  "name": "k9mesh",
  "private": true,
  "version": "2.0.0",
  "description": "K9Mesh Search & Rescue Rover Command Center",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:app": "tsc -p tsconfig.node.json && cross-env NODE_ENV=development concurrently \"vite --port 5174 --strict-port\" \"wait-on http://localhost:5174 && electron .\"",
    "build": "vite build",
    "build:app": "vite build && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "lint": "oxlint",
    "package": "npm run build:app && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "integration:test": "npm run build:app && cross-env K9_INTEGRATION_TEST=1 electron . --integration-test",
    "integration:verify": "node scratch/run_qualification_suite.js"
  },
  "build": {
    "appId": "com.k9mesh.commander",
    "productName": "K9MESH",
    "copyright": "Copyright © 2026 K9Mesh",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.svg"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
